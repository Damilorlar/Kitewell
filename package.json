{
  "name": "helios-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Helios Lab monorepo — frontend, backend, and Soroban contracts for Stellar Testnet",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:all": "npm run dev -w backend & npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "build:frontend": "npm run build -w frontend",
    "start:backend": "npm run start -w backend",
    "lint": "npm run lint -w frontend",
    "build:contracts": "stellar contract build --manifest-path contracts/helios_lab/Cargo.toml",
    "test:contracts": "cargo test --manifest-path contracts/helios_lab/Cargo.toml"
  },
  "engines": {
    "node": ">=20"
  }
}
